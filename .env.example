# Copia este archivo como .env y completa los valores.
SECRET_KEY=cambia-esto-por-un-texto-largo-y-aleatorio
FLASK_DEBUG=1
# DATABASE_URL=   (vacío = SQLite local en instance/fibrea.db)

# ---- Generación de imágenes con IA ("Crea tu Fibrea") ----
# gemini | openai  (si lo dejas vacío se usa el primero que tenga API key)
IMAGE_PROVIDER=gemini

GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium   (low = más barato y rápido, high = mejor detalle y más caro)

# ---- Contacto del emprendimiento ----
WHATSAPP_NUMBER=593999774777
CONTACT_EMAIL=hola@fibrea.ec
INSTAGRAM_URL=https://www.instagram.com/

# ---- Panel /admin (obligatorio en producción) ----
ADMIN_USER=admin
ADMIN_PASSWORD=
